#Область Сортировка

// Сортирует массив структур по указанному полю
//
// Параметры:
//  МассивСтруктур - Массив - массив структур для сортировки
//  ПолеСортировки - Строка - имя поля для сортировки
//  ПоУбыванию - Булево - сортировать по убыванию (по умолчанию Ложь - по возрастанию)
//
&НаКлиенте
Процедура СортироватьМассивСтруктур(МассивСтруктур, ПолеСортировки, ПоУбыванию = Ложь) Экспорт
	Если МассивСтруктур.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	// Простая сортировка пузырьком
	КоличествоЭлементов = МассивСтруктур.Количество();
	Для i = 0 По КоличествоЭлементов - 2 Цикл
		Для j = 0 По КоличествоЭлементов - 2 - i Цикл
			// Получаем значения для сравнения
			Значение1 = МассивСтруктур[j][ПолеСортировки];
			Значение2 = МассивСтруктур[j + 1][ПолеСортировки];
			
			// Определяем, нужно ли менять местами
			НужноМенять = Ложь;
			Если ПоУбыванию Тогда
				// По убыванию: если первый элемент меньше второго
				НужноМенять = Значение1 < Значение2;
			Иначе
				// По возрастанию: если первый элемент больше второго
				НужноМенять = Значение1 > Значение2;
			КонецЕсли;
			
			// Меняем местами элементы
			Если НужноМенять Тогда
				ВременныйЭлемент = МассивСтруктур[j];
				МассивСтруктур[j] = МассивСтруктур[j + 1];
				МассивСтруктур[j + 1] = ВременныйЭлемент;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

