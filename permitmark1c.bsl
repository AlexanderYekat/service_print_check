// Выполняет JSON запрос с автоматическим парсингом
//
// Параметры:
//  URL        - Строка - URL для запроса
//  Заголовки  - Соответствие - заголовки запроса
//  Тело       - Строка - тело запроса в формате JSON
//  Таймаут    - Число - таймаут в секундах
//
// Возвращаемое значение:
//  Структура - результат выполнения запроса с распарсенными данными
//
&НаКлиенте
Функция ВыполнитьJSONЗапрос(URL, Заголовки, Тело = "", Таймаут = 30, лм = ЛОЖЬ) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	
	// Выполняем HTTP запрос
	HTTPРезультат = ВыполнитьHTTPЗапрос(URL, Заголовки, Тело, Таймаут, лм);
	
	Если Не HTTPРезультат.Успех Тогда
		Результат.Сообщение = HTTPРезультат.Сообщение;
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем HTTP код
	HTTPОтвет = HTTPРезультат.Данные;
	Результат.КодОшибки = HTTPОтвет.КодСостояния;
	
	Если HTTPОтвет.КодСостояния <> 200 Тогда
		Результат.Сообщение = "HTTP ошибка: " + HTTPОтвет.КодСостояния;
		Возврат Результат;
	КонецЕсли;
	
	// Парсим JSON
	URI = СтруктураURI(URL);
	Если URI.ПутьНаСервере = "/api/v1/init" тогда
		Результат.Успех = Истина;
		Возврат Результат;
	конецЕсли;
	
	Попытка
		// Используем правильный подход для 1С с объектом ЧтениеJSON
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
		JSONДанные = ПрочитатьJSON(ЧтениеJSON);
		Результат.Успех = Истина;
		Результат.Данные = JSONДанные;
		Логировать("JSON успешно распарсен");
		
	Исключение
		Результат.Сообщение = "Ошибка парсинга JSON: " + ОписаниеОшибки();
		Логировать("Ошибка парсинга JSON: " + Результат.Сообщение, "ERROR");
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ВспомогательныеФункции

// Преобразует строку формата ISO 8601 в объект типа Дата
//
// Параметры:
//  СтрокаДаты - Строка - строка даты в формате "2025-08-13T08:34:42"
//
// Возвращаемое значение:
//  Дата - объект типа Дата или Неопределено при ошибке
//
&НаКлиенте
Функция ПреобразоватьСтрокуВДату(СтрокаДаты) Экспорт
	Попытка
		// Преобразуем строку формата "2025-08-13T08:34:42" в "13-08-2025 08:34:42"
		// Разбираем исходную строку
		Год = Лев(СтрокаДаты, 4);
		Месяц = Сред(СтрокаДаты, 6, 2);
		День = Сред(СтрокаДаты, 9, 2);
		Время = Сред(СтрокаДаты, 12, 8);
		
		// Формируем строку в формате 1С
		СтрокаДляПарсинга = День + "-" + Месяц + "-" + Год + " " + Время;
		
		// Убираем миллисекунды если есть
		ПозицияТочки = СтрНайти(СтрокаДляПарсинга, ".");
		Если ПозицияТочки > 0 Тогда
			СтрокаДляПарсинга = Лев(СтрокаДляПарсинга, ПозицияТочки - 1);
		КонецЕсли;                                      
		СтрокаДляПарсинга = СтрЗаменить(СтрокаДляПарсинга, "-", ".");
		
		Возврат Дата(СтрокаДляПарсинга);
	Исключение
		Логировать("Ошибка преобразования строки в дату: " + СтрокаДаты + ", " + ОписаниеОшибки(), "WARNING");
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область CDNУправление

// Загружает кэш CDN из JSON файла
//
// Возвращаемое значение:
//  Массив - массив CDN площадок или Неопределено при ошибке
//
&НаКлиенте
Функция ЗагрузитьКэшCDN(ПутьКэшаCDN) Экспорт
	файлКэшаCDNПроверкаСущестования = Новый Файл(ПутьКэшаCDN);		
	Попытка
		// Проверяем существование файла кэша
		Если Не файлКэшаCDNПроверкаСущестования.Существует() Тогда
			Логировать("Файл кэша CDN не найден: " + ПутьКэшаCDN);
			Возврат Неопределено;
		КонецЕсли;
		
		// Читаем JSON файл
		//JSONТекст = ЧитатьТекст(ПутьКэшаCDN);
		//Если СокрЛП(JSONТекст) = "" Тогда
		//	Логировать("Файл кэша CDN пуст");
		//	Возврат Неопределено;
		//КонецЕсли;
		
		// Парсим JSON
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.ОткрытьФайл(ПутьКэшаCDN);
		//ЧтениеJSON.УстановитьСтроку(JSONТекст);
		КэшCDN = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		// Преобразуем строковые даты в объекты типа Дата
		Если КэшCDN <> Неопределено И ТипЗнч(КэшCDN) = Тип("Массив") Тогда
			Для Каждого CDN Из КэшCDN Цикл
				Если CDN.Свойство("ОбновленоВ") И ТипЗнч(CDN.ОбновленоВ) = Тип("Строка") Тогда
					ПреобразованнаяДата = ПреобразоватьСтрокуВДату(CDN.ОбновленоВ);
					Если ПреобразованнаяДата <> Неопределено Тогда
						CDN.ОбновленоВ = ПреобразованнаяДата;
					Иначе
						CDN.ОбновленоВ = ТекущаяДата();
					КонецЕсли;
				КонецЕсли;
				
				Если CDN.Свойство("НедоступенДо") И ТипЗнч(CDN.НедоступенДо) = Тип("Строка") Тогда
					ПреобразованнаяДата = ПреобразоватьСтрокуВДату(CDN.НедоступенДо);
					Если ПреобразованнаяДата <> Неопределено Тогда
						CDN.НедоступенДо = ПреобразованнаяДата;
					Иначе
						CDN.Удалить("НедоступенДо");
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Логировать("Кэш CDN загружен из файла: " + ПутьКэшаCDN + ", площадок: " + КэшCDN.Количество());
		Возврат КэшCDN;
		
	Исключение
		Логировать("Ошибка загрузки кэша CDN: " + ОписаниеОшибки(), "ERROR");
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Сохраняет кэш CDN в JSON файл
//
// Параметры:
//  КэшCDN - Массив - массив CDN площадок для сохранения
//
// Возвращаемое значение:
//  Булево - Истина при успешном сохранении
//
&НаКлиенте
Функция СохранитьКэшCDN(КэшCDN, ПутьКэшаCDN) Экспорт
	Попытка
		// Проверяем входные параметры
		Если КэшCDN = Неопределено Тогда
			Логировать("Ошибка: кэш CDN не определен");
			Возврат Ложь;
		КонецЕсли;
		
		// Создаем JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ОткрытьФайл(ПутьКэшаCDN);
		//ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, КэшCDN);
		//JSONТекст = ЗаписьJSON.Закрыть();
		ЗаписьJSON.Закрыть();
		
		// Сохраняем в файл
		//ЗаписатьТекст(ПутьКэшаCDN, JSONТекст);
		
		Логировать("Кэш CDN сохранен в файл: " + ПутьКэшаCDN + ", площадок: " + КэшCDN.Количество());
		Возврат Истина;
		
	Исключение
		Логировать("Ошибка сохранения кэша CDN: " + ОписаниеОшибки(), "ERROR");
		Возврат Ложь;
	КонецПопытки;
КонецФункции

	// Очищает пометки о недоступности CDN площадок
//
&НаКлиенте
Процедура ОчиститьНедоступныеCDN(ПутьКэшаCDN) Экспорт
	КэшCDN = ЗагрузитьКэшCDN(ПутьКэшаCDN);
	Если КэшCDN = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// В тонком клиенте используем ТекущаяДатаСеанса() вместо ТекущаяДата()
	ТекущееВремя =  ТекущаяДата();
	Изменен = Ложь;
	
	Для Каждого CDN Из КэшCDN Цикл
		Если CDN.Свойство("НедоступенДо") И CDN.НедоступенДо < ТекущееВремя Тогда
			CDN.Удалить("НедоступенДо");
			Изменен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Изменен Тогда
		СохранитьКэшCDN(КэшCDN, ПутьКэшаCDN);
		Логировать("Очищены пометки о недоступности CDN");
	КонецЕсли;
КонецПроцедуры

	// Помечает CDN площадку как недоступную на заданное время
//
// Параметры:
//  ХостCDN - Строка - хост CDN площадки
//
&НаКлиенте
Процедура ПометитьCDNНедоступным(ХостCDN, ПутьКэшаCDN) Экспорт
	КэшCDN = ЗагрузитьКэшCDN(ПутьКэшаCDN);
	Если КэшCDN = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// В тонком клиенте используем ТекущаяДата() вместо ТекущаяДата()
	ТекущееВремя =  ТекущаяДата();
	Изменен = Ложь;
	
	Для Каждого CDN Из КэшCDN Цикл
		Если CDN.Хост = ХостCDN Тогда
			// В тонком клиенте используем простую логику без ДобавитьСекунду
			CDN.НедоступенДо = ТекущееВремя;
			Изменен = Истина;
			Логировать("CDN помечен как недоступный: " + ХостCDN + " до " + CDN.НедоступенДо);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Изменен Тогда
		СохранитьКэшCDN(КэшCDN, ПутьКэшаCDN);
	КонецЕсли;
КонецПроцедуры

// Получает список CDN площадок через API Честного знака
//
// Параметры:
//  Параметры - Структура - параметры для запроса (токен, продуктивный контур)
//
// Возвращаемое значение:
//  Структура - результат получения списка CDN
//
&НаКлиенте
Функция ПолучитьСписокCDN(ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	
	// Проверяем наличие токена
	Если СтрДлина(ПараметрыЧестныйЗнак.ТокенAPI) = 0 Тогда
		Результат.Сообщение = "Токен API не указан";
		Возврат Результат;
	КонецЕсли;
	
	// Формируем URL в зависимости от контура
	Если ПараметрыЧестныйЗнак.ПродуктивныйКонтур Тогда
		БазовыйURL = "https://cdn.crpt.ru";
	Иначе
		БазовыйURL = "https://markirovka.sandbox.crptech.ru";
	КонецЕсли;
	
	URL = БазовыйURL + "/api/v4/true-api/cdn/info";
	Заголовки = СформироватьЗаголовкиAPI(ПараметрыЧестныйЗнак.ТокенAPI);
	
	Логировать("Запрашиваем список CDN площадок: " + URL);
	
	// Выполняем запрос
	APIРезультат = ВыполнитьJSONЗапрос(URL, Заголовки, "", 30);
	
	Если Не APIРезультат.Успех Тогда
		Результат.Сообщение = "Ошибка получения списка CDN: " + APIРезультат.Сообщение;
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем структуру ответа
	Данные = APIРезультат.Данные;
	Если Не Данные.Свойство("hosts") Тогда
		Результат.Сообщение = "Некорректная структура ответа API: отсутствует поле 'hosts'";
		Возврат Результат;
	КонецЕсли;
	
	// Формируем результат
	Результат.Успех = Истина;
	Результат.Данные = Данные["hosts"];
	Результат.Сообщение = "Список CDN площадок успешно получен";
	
	Логировать("Получено CDN площадок: " + Данные["hosts"].Количество());
	
	Возврат Результат;
КонецФункции

// Проверяет доступность CDN площадки и измеряет задержку
//
// Параметры:
//  ХостCDN - Строка - хост CDN площадки для проверки
//  ПараметрыЧестныйЗнак - Структура - ПараметрыЧестныйЗнак для запроса
//
// Возвращаемое значение:
//  Структура - результат проверки здоровья CDN
//
&НаКлиенте
Функция ПроверитьЗдоровьеCDN(ХостCDN, ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	
	// Проверяем наличие токена
	Если СтрДлина(ПараметрыЧестныйЗнак.ТокенAPI) = 0 Тогда
		Результат.Сообщение = "Токен API не указан";
		Возврат Результат;
	КонецЕсли;
	
	// Формируем URL для проверки здоровья
	URL = ХостCDN + "/api/v4/true-api/cdn/health/check";
	Заголовки = СформироватьЗаголовкиAPI(ПараметрыЧестныйЗнак.ТокенAPI);
	
	Логировать("Проверяем здоровье CDN: " + ХостCDN);
	
	// Засекаем время начала
	// В тонком клиенте используем ТекущаяДатаСеанса() вместо ТекущаяДата()
	НачалоВремени =  ТекущаяДата();
	
	// Выполняем запрос с таймаутом 5 секунд
	APIРезультат = ВыполнитьJSONЗапрос(URL, Заголовки, "", 5);
	
	// Вычисляем задержку в миллисекундах
	КонецВремени =  ТекущаяДата();
	Задержка = Цел((КонецВремени - НачалоВремени) * 24 * 3600 * 1000);
	
	// Формируем результат
	Результат.Данные = Новый Структура;
	Результат.Данные.Вставить("Хост", ХостCDN);
	Результат.Данные.Вставить("Задержка", Задержка);
	Результат.Данные.Вставить("Доступен", APIРезультат.Успех);
	
	Если APIРезультат.Успех Тогда
		Результат.Успех = Истина;
		Результат.Сообщение = "CDN доступен, задержка: " + Задержка + " мс";
		Логировать("CDN " + ХостCDN + " доступен, задержка: " + Задержка + " мс");
	Иначе
		Результат.Сообщение = "CDN недоступен: " + APIРезультат.Сообщение;
		Логировать("CDN " + ХостCDN + " недоступен: " + APIРезультат.Сообщение, "WARNING");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Обновляет кэш CDN площадок через API
//
// Параметры:
//  ПараметрыЧестныйЗнак - Структура - ПараметрыЧестныйЗнак для обновления
//
// Возвращаемое значение:
//  Структура - результат обновления кэша
//
&НаКлиенте
Функция ОбновитьКэшCDN(ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	
	Логировать("Начинаем обновление кэша CDN");
	
	// Получаем список CDN площадок
	СписокCDN = ПолучитьСписокCDN(ПараметрыЧестныйЗнак);
	Если Не СписокCDN.Успех Тогда
		Результат.Сообщение = "Не удалось получить список CDN: " + СписокCDN.Сообщение;
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем здоровье каждой площадки
	НовыйКэш = Новый Массив;
	// В тонком клиенте используем ТекущаяДатаСеанса() вместо ТекущаяДата()
	ТекущееВремя =  ТекущаяДата();
	
	Для Каждого CDNХост Из СписокCDN.Данные Цикл
		Логировать("Проверяем CDN: " + CDNХост);
		
		ЗдоровьеCDN = ПроверитьЗдоровьеCDN(CDNХост.host, ПараметрыЧестныйЗнак);
		
		// Создаем запись для кэша
		ЗаписьCDN = Новый Структура;
		ЗаписьCDN.Вставить("Хост", CDNХост.host);
		ЗаписьCDN.Вставить("Задержка", ЗдоровьеCDN.Данные.Задержка);
		ЗаписьCDN.Вставить("Доступен", ЗдоровьеCDN.Данные.Доступен);
		ЗаписьCDN.Вставить("ОбновленоВ", ТекущееВремя);
		
		НовыйКэш.Добавить(ЗаписьCDN);
	КонецЦикла;
	
		// Сортируем по задержке (от меньшей к большей)
	// Пример: сортировка CDN площадок по времени отклика для выбора наиболее быстрых
	СортироватьМассивСтруктур(НовыйКэш, "Задержка");
	
	// Сохраняем обновленный кэш
	Если СохранитьКэшCDN(НовыйКэш, ПараметрыЧестныйЗнак.ПутьКэшаCDN) Тогда
		Результат.Успех = Истина;
		Результат.Сообщение = "Кэш CDN обновлен, площадок: " + НовыйКэш.Количество();
		Результат.Данные = НовыйКэш;
		Логировать("Кэш CDN успешно обновлен, площадок: " + НовыйКэш.Количество());
	Иначе
		Результат.Сообщение = "Не удалось сохранить обновленный кэш CDN";
		Логировать("Ошибка сохранения кэша CDN", "ERROR");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

