// Выполняет HTTP-запрос с обработкой ошибок
//
// Параметры:
//  URL        - Строка - URL для запроса
//  Заголовки  - Массив - массив заголовков
//  Тело       - Строка - тело запроса (для POST)
//  Таймаут    - Число - таймаут в секундах
//
// Возвращаемое значение:
//  Структура - результат выполнения запроса
//
&НаКлиенте
Функция ВыполнитьHTTPЗапрос(URL, Заголовки, Тело = "", Таймаут = 30, лм = ложь) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	
	Попытка
		// Парсим URL для получения хоста и порта
		URI = СтруктураURI(URL);
		
		// Создаем HTTP соединение
		Если лм тогда
			HTTPСоединение = Новый HTTPСоединение(
				URI.Хост,
				?(URI.Порт <> Неопределено, URI.Порт, 80),
				, // пользователь
				, // пароль
				, // прокси
				Таймаут
			);			
		иначе
			HTTPСоединение = Новый HTTPСоединение(
				URI.Хост,
				?(URI.Порт <> Неопределено, URI.Порт, 80),
				, // пользователь
				, // пароль
				, // прокси
				Таймаут,
				Новый ЗащищенноеСоединениеOpenSSL()// таймаут
			);
		конецЕсли;
		
		// Используем заголовки напрямую
		ЗаголовкиЗапроса = Заголовки;
		
		// Создаем HTTP запрос
		HTTPЗапрос = Новый HTTPЗапрос(URI.ПутьНаСервере, ЗаголовкиЗапроса);
		
		// Устанавливаем тело для POST запроса
		Если Тело <> "" Тогда
			HTTPЗапрос.УстановитьТелоИзСтроки(Тело);
		КонецЕсли;
		
		// Выполняем запрос
		Если Тело <> "" Тогда
			// POST запрос
			HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Иначе
			// GET запрос
			HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		КонецЕсли;
		
		Результат.Успех = Истина;
		Результат.Данные = HTTPОтвет;
		Результат.КодОшибки = HTTPОтвет.КодСостояния;
		
		Логировать("HTTP запрос выполнен успешно. Код: " + HTTPОтвет.КодСостояния);
		
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
		Логировать("Ошибка HTTP запроса: " + Результат.Сообщение, "ERROR");
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Формирует заголовки для API запросов
//
// Параметры:
//  Токен - Строка - токен API для авторизации
//
// Возвращаемое значение:
