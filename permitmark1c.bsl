// Парсит URL и возвращает его компоненты
//
// Параметры:
//  URL - Строка - URL для парсинга
//
// Возвращаемое значение:
//  Структура - структура с полями Хост, Порт, ПутьНаСервере
//
&НаКлиенте
Функция СтруктураURI(URL) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Хост", "");
	Результат.Вставить("Порт", Неопределено);
	Результат.Вставить("ПутьНаСервере", "");
	
	// Сохраняем оригинальный URL для определения протокола
	ОригинальныйURL = URL;
	
	// Убираем протокол
	ПозицияПротокола = Найти(URL, "://");
	Если ПозицияПротокола > 0 Тогда
		URL = Сред(URL, ПозицияПротокола + 3);
	КонецЕсли;
	
	// Ищем позицию первого слеша для отделения хоста от пути
	ПозицияСлеша = Найти(URL, "/");
	Если ПозицияСлеша > 0 Тогда
		ХостИПорт = Лев(URL, ПозицияСлеша - 1);
		Результат.ПутьНаСервере = Сред(URL, ПозицияСлеша);
	Иначе
		ХостИПорт = URL;
		Результат.ПутьНаСервере = "/";
	КонецЕсли;
	
	// Разделяем хост и порт
	ПозицияДвоеточия = Найти(ХостИПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Хост = Лев(ХостИПорт, ПозицияДвоеточия - 1);
		Результат.Порт = Число(Сред(ХостИПорт, ПозицияДвоеточия + 1));
	Иначе
		Результат.Хост = ХостИПорт;
		// Порт по умолчанию для HTTP/HTTPS
		Если Найти(ОригинальныйURL, "https://") > 0 Тогда
			Результат.Порт = 443;
		Иначе
			Результат.Порт = 80;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

