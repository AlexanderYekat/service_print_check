// Объединяет пользовательские параметры с параметрами по умолчанию
//
// Параметры:
//  ПользовательскиеПараметры - Структура - пользовательские параметры
//
// Возвращаемое значение:
//  Структура - объединенные параметры
//
&НаКлиенте
Функция ОбъединитьПараметры(ПользовательскиеПараметры = Неопределено) Экспорт
	ПараметрыПоУмолчанию = ПолучитьПараметрыПоУмолчанию();
	
	Если ПользовательскиеПараметры = Неопределено Тогда
		Возврат ПараметрыПоУмолчанию;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	// Копируем все параметры по умолчанию
	Для Каждого КлючИЗначение Из ПараметрыПоУмолчанию Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	// Переопределяем пользовательскими параметрами
	Для Каждого КлючИЗначение Из ПользовательскиеПараметры Цикл
		Если Результат.Свойство(КлючИЗначение.Ключ) Тогда
			Результат[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		Иначе
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

