// Проверяет готовность локального модуля ЧЗ
//
// Параметры:
//  ПараметрыЧестныйЗнак - Структура - ПараметрыЧестныйЗнак для проверки
//
// Возвращаемое значение:
//  Структура - результат проверки готовности
//
&НаКлиенте
Функция ПроверитьГотовностьЛМЧЗ(ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	
	// Формируем URL для проверки статуса
	URL = СокрЛП(ПараметрыЧестныйЗнак.ХостЛМЧЗ) + "/api/v1/status";
	
	// Формируем заголовки с базовой авторизацией
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Basic " + ПараметрыЧестныйЗнак.АвторизацияЛМЧЗ);
	Заголовки.Вставить("Content-Type", "application/json");
	
	Логировать("Проверяем готовность ЛМ ЧЗ: " + URL);
	
	// Выполняем запрос к ЛМ ЧЗ
	РезультатAPI = ВыполнитьJSONЗапрос(URL, Заголовки, "", 10, ИСТИНА);
	
	Если Не РезультатAPI.Успех Тогда
		Результат.Сообщение = "Ошибка запроса к ЛМ ЧЗ: " + РезультатAPI.Сообщение;
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем HTTP код
	Если РезультатAPI.КодОшибки <> 200 Тогда
		Результат.Сообщение = "ЛМ ЧЗ вернул HTTP код: " + РезультатAPI.КодОшибки;
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем наличие данных
	Данные = РезультатAPI.Данные;
	Если Данные = Неопределено Тогда
		Результат.Сообщение = "Ошибка декодирования ответа ЛМ ЧЗ";
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем статус готовности
	Если НЕ Данные.Свойство("status") Тогда
		Результат.Сообщение = "В ответе ЛМ ЧЗ отсутствует поле ready";
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ Данные.status = "ready" Тогда
		Результат.Сообщение = "ЛМ ЧЗ не готов к работе";
		Результат.Сообщение = Результат.Сообщение + ": " + Данные.status;
		Логировать(Результат.Сообщение, "WARNING");
		Возврат Результат;
	КонецЕсли;
	
	//// Проверяем время последней синхронизации (не более 72 часов)
	//Если Данные.Свойство("lastSync") Тогда
	//	ПоследняяСинхронизация = Данные.lastSync / 1000; // Переводим из миллисекунд в секунды
	//	ТекущееВремя = ТекущаяДата();
	//	ВозрастСинхронизации = ТекущееВремя - ПоследняяСинхронизация;
	//	
	//	Если ВозрастСинхронизации > 72 * 3600 Тогда // 72 часа в секундах
	//		Результат.Сообщение = "ЛМ ЧЗ не синхронизировался более 72 часов. Последняя синхронизация: " + Формат(ПоследняяСинхронизация, "ДФ=dd.MM.yyyy HH:mm:ss");
	//		Логировать(Результат.Сообщение, "WARNING");
	//		Возврат Результат;
	//	КонецЕсли;
	//КонецЕсли;
	
	// ЛМ ЧЗ готов к работе
	Результат.Успех = Истина;
	Результат.Сообщение = "ЛМ ЧЗ готов к работе";
	Результат.Данные = Данные;
	
	Логировать("ЛМ ЧЗ готов к работе");
	
	Возврат Результат;
КонецФункции

