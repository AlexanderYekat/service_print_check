	Попытка
		// Проверяем доступность основных функций
		ПараметрыЧестныйЗнак = ПолучитьПараметрыПоУмолчанию();
		Если ПараметрыЧестныйЗнак.Количество() = 0 Тогда
			ВызватьИсключение "Функция ПолучитьПараметрыПоУмолчанию не работает";
		КонецЕсли;
		
		ОбъединенныеПараметры = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
