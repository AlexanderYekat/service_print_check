// Извлекает код идентификации (CIS) из кода маркировки
//
// Параметры:
//  КодМаркировки - Строка - код маркировки товара
//
// Возвращаемое значение:
//  Строка - код идентификации или пустая строка при ошибке
//
&НаКлиенте
Функция ИзвлечьCISИзМаркировки(КодМаркировки) Экспорт
	Если СтрДлина(КодМаркировки) = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	// Убираем пробелы и переводы строк
	КодМаркировки = СокрЛП(КодМаркировки);
	
	// TODO: Реализовать логику извлечения CIS согласно стандарту GS1
	// Пока возвращаем исходный код
	Логировать("Извлечение CIS из маркировки: " + КодМаркировки);
	
	Возврат КодМаркировки;
КонецФункции

// Проверяет код идентификации в локальном модуле ЧЗ
//
// Параметры:
//  CIS        - Строка - код идентификации для проверки
//  ПараметрыЧестныйЗнак  - Структура - ПараметрыЧестныйЗнак для проверки
//
// Возвращаемое значение:
//  Структура - результат проверки CIS
//
&НаКлиенте
Функция ПроверитьCISВЛМЧЗ(CIS, ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	JSONТекст = "";
	
	// Проверяем входные параметры
	Если СтрДлина(CIS) = 0 Тогда
		Результат.Сообщение = "Код идентификации не может быть пустым";
		Возврат Результат;
	КонецЕсли;
	
	// Формируем URL для проверки CIS
	URL = СокрЛП(ПараметрыЧестныйЗнак.ХостЛМЧЗ) + "/api/v1/cis/check?cis="+СокрЛП(CIS);
	
	// Формируем заголовки с базовой авторизацией
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Basic " + ПараметрыЧестныйЗнак.АвторизацияЛМЧЗ);
	Заголовки.Вставить("Content-Type", "application/json");
			
	Логировать("Проверяем CIS в ЛМ ЧЗ: " + CIS);
	
	// Выполняем запрос к ЛМ ЧЗ
	// Используем правильный подход для 1С с объектом ЗаписьJSON
	РезультатAPI = ВыполнитьJSONЗапрос(URL, Заголовки, , 30, ИСТИНА);
	
	Если Не РезультатAPI.Успех Тогда
		Результат.Сообщение = "Ошибка запроса к ЛМ ЧЗ: " + РезультатAPI.Сообщение;
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем HTTP код
	Если РезультатAPI.КодОшибки <> 200 Тогда
		Результат.Сообщение = "ЛМ ЧЗ вернул HTTP код: " + РезультатAPI.КодОшибки;
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем наличие данных
	Данные = РезультатAPI.Данные;
	Если Данные = Неопределено Тогда
		Результат.Сообщение = "Ошибка декодирования ответа ЛМ ЧЗ";
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем структуру ответа
	Если НЕ Данные.Свойство("code") Тогда
		Результат.Сообщение = "В ответе ЛМ ЧЗ отсутствует поле code";
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	Результаты = Данные.codes;
	Если ТипЗнч(Результаты) <> Тип("Массив") Или Результаты.Количество() = 0 Тогда
		Результат.Сообщение = "В ответе ЛМ ЧЗ отсутствуют результаты проверки";
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Получаем результат для первого кода
	РезультатПроверки = Результаты[0];
	Если НЕ РезультатПроверки.Свойство("isBlocked") Тогда
		Результат.Сообщение = "В результате проверки отсутствует поле isBlocked";
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем код результата
	КодРезультата = РезультатПроверки.isBlocked;
	Если КодРезультата = true Тогда
		Описание = "";
		Если РезультатПроверки.Свойство("description") <> Неопределено Тогда
			Описание = ": " + РезультатПроверки.description;
		КонецЕсли;
		Результат.Сообщение = "Ошибка проверки CIS в ЛМ ЧЗ (код " + КодРезультата + ")" + Описание;
		Логировать(Результат.Сообщение, "WARNING");
		Возврат Результат;
	КонецЕсли;
	
	// Успешная проверка
	Результат.Успех = Истина;
	Результат.Сообщение = "CIS успешно проверен в ЛМ ЧЗ";
	Результат.Данные = Данные;
	
	Логировать("CIS успешно проверен в ЛМ ЧЗ");
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ОсновнаяЛогика

// Основная функция проверки маркировки товара
//
// Параметры:
//  КодМаркировки - Строка - код маркировки для проверки
//  ПараметрыЧестныйЗнак     - Структура - параметры проверки
//
// Возвращаемое значение:
//  Структура - результат проверки маркировки
//
&НаКлиенте
Функция ПроверитьМаркировку(КодМаркировки, ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	
	// Проверяем входные параметры
	Если СтрДлина(КодМаркировки) = 0 Тогда
		Результат.Сообщение = "Код маркировки не может быть пустым";
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	
	Логировать("Начинаем проверку маркировки: " + КодМаркировки);
	
	// Сначала пробуем онлайн проверку
	ОнлайнРезультат = ПроверитьОнлайн(КодМаркировки, ПараметрыЧестныйЗнак);
	
	Если ОнлайнРезультат.Успех Тогда
		Результат = ОнлайнРезультат;
		Если ОнлайнРезультат.Данные.code <> 0 тогда
			ОнлайнРезультат.Успех = ЛОЖЬ;
			ОнлайнРезультат.КодОшибки = ОнлайнРезультат.Данные.code;
			ОнлайнРезультат.Сообщение = ОнлайнРезультат.Данные.description;
			Возврат Результат;
		конецЕсли;    
		Если ОнлайнРезультат.ПровереноОфлайн тогда			
			Для Каждого марка из ОнлайнРезультат.Данные.Codes цикл
				Если марка.isBlocked тогда
					ОнлайнРезультат.Успех = ЛОЖЬ;
					ОнлайнРезультат.КодОшибки = "200";
					ОнлайнРезультат.Сообщение = "Марка заблокирована по решению органов государственной власти";
					Возврат Результат;					
				конецЕсли;
			конецЦикла;
		конецЕсли;
		Логировать("Запос проверки марки успешно обработан");
		Для Каждого марка из ОнлайнРезультат.Данные.Codes цикл			
			ОнлайнРезультат.КодОшибки = марка.errorCode;
			Если марка.errorCode <> 0 тогда
				ОнлайнРезультат.Успех = ЛОЖЬ;
			иначе
				ОнлайнРезультат.reqId        = марка.reqId;
				ОнлайнРезультат.reqTimestamp = марка.reqTimestamp;
			конецЕсли;
			ОнлайнРезультат.Сообщение = марка.message;
			Если НЕ марка.isBlocked тогда
				ОнлайнРезультат.Сообщение = "Марка заблокирована по решению органов государственной власти";
			конецЕсли;		
			Если марка.Свойство("expireDate") и марка.expireDate тогда
				ОнлайнРезультат.Сообщение = "У товара истёк срок годности";
			конецЕсли;
			Если НЕ марка.sold тогда
				ОнлайнРезультат.Сообщение = "марка уже выведана из оборота";
			конецЕсли;			                        			
			Если НЕ марка.verified тогда
				ОнлайнРезультат.Сообщение = "марка не прошла проверку";
			конецЕсли;			
			Если НЕ марка.found тогда  
				ОнлайнРезультат.Сообщение = "марка не найдена";
			конецЕсли;                                         			
			Если НЕ марка.valid тогда
				ОнлайнРезультат.Сообщение = "Не валидная марка";
			конецЕсли;			
			Прервать;
		конецЦикла;              
		Возврат Результат;
	КонецЕсли;
	
	// Если онлайн проверка не удалась, переходим к офлайн
	Логировать("Онлайн проверка не удалась, переходим к офлайн проверке");
	Результат = ПроверитьОфлайн(КодМаркировки, ПараметрыЧестныйЗнак);
	
	Если ОнлайнРезультат.Успех Тогда
		Если ОнлайнРезультат.Данные.code <> 0 тогда
			ОнлайнРезультат.Успех = ЛОЖЬ;
			ОнлайнРезультат.КодОшибки = ОнлайнРезультат.Данные.code;
			ОнлайнРезультат.Сообщение = ОнлайнРезультат.Данные.description;
			Возврат Результат;
		конецЕсли;   
		Если ОнлайнРезультат.ПровереноОфлайн тогда			
			Для Каждого марка из ОнлайнРезультат.Данные.Codes цикл
				Если марка.isBlocked тогда
					ОнлайнРезультат.Успех = ЛОЖЬ;
					ОнлайнРезультат.КодОшибки = "200";
					ОнлайнРезультат.Сообщение = "Марка заблокирована по решению органов государственной власти";
					Возврат Результат;					
				конецЕсли;
			конецЦикла;
		конецЕсли;		
	конецЕсли;
	
	Возврат Результат;
КонецФункции  

// Выполняет онлайн проверку маркировки через CDN площадки
//
// Параметры:
//  КодМаркировки - Строка - код маркировки для проверки
//  ПараметрыЧестныйЗнак     - Структура - параметры проверки
//
// Возвращаемое значение:
//  Структура - результат онлайн проверки
//
&НаКлиенте
Функция ПроверитьОнлайн(КодМаркировки, ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	JSONТекст = "";
	
	// Проверяем наличие токена API
	Если СтрДлина(ПараметрыЧестныйЗнак.ТокенAPI) = 0 Тогда
		Результат.Сообщение = "Токен API не указан";
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	Логировать("Начинаем онлайн проверку маркировки: " + КодМаркировки);
	
	// 1. Получаем кэш CDN и очищаем недоступные
	ОчиститьНедоступныеCDN(ПараметрыЧестныйЗнак.ПутьКэшаCDN);
	КэшCDN = ЗагрузитьКэшCDN(ПараметрыЧестныйЗнак.ПутьКэшаCDN);
	// В тонком клиенте используем ТекущаяДата() вместо ТекущаяДата()
	ТекущееВремя = ТекущаяДата();
	
	// Проверяем необходимость обновления кэша (не более 6 часов)
	НужноОбновить = Ложь;
	Если КэшCDN = Неопределено Или КэшCDN.Количество() = 0 Тогда
		НужноОбновить = Истина;
	ИначеЕсли КэшCDN.Количество() > 0 И КэшCDN[0].Свойство("ОбновленоВ") Тогда
		ВремяОбновления = КэшCDN[0].ОбновленоВ;
		РазностьВремени = ТекущееВремя - ВремяОбновления;
		Если РазностьВремени > 6 * 3600 Тогда // 6 часов в секундах
			НужноОбновить = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Обновляем кэш CDN если нужно
	Если НужноОбновить Тогда
		Логировать("Обновляем кэш CDN площадок");
		РезультатОбновления = ОбновитьКэшCDN(ПараметрыЧестныйЗнак);
		Если Не РезультатОбновления.Успех Тогда
			Логировать("Ошибка обновления кэша CDN: " + РезультатОбновления.Сообщение + ". Переходим к офлайн проверке.");
			Результат.Сообщение = "Не удалось получить список CDN площадок";
			Возврат Результат;
		КонецЕсли;
		КэшCDN = ЗагрузитьКэшCDN(ПараметрыЧестныйЗнак.ПутьКэшаCDN);
	КонецЕсли;
	
	// 2. Фильтруем доступные CDN
	ДоступныеCDN = Новый Массив;
	Для Каждого CDN Из КэшCDN Цикл
		Если НЕ CDN.Свойство("НедоступенДо") или CDN.НедоступенДо <= ТекущееВремя Тогда
			ДоступныеCDN.Добавить(CDN);
		КонецЕсли;
	КонецЦикла;
	
	// Если все CDN недоступны, сбрасываем недоступность
	Если ДоступныеCDN.Количество() = 0 Тогда
		Логировать("Все CDN недоступны, сбрасываем недоступность");
		ОчиститьНедоступныеCDN(ПараметрыЧестныйЗнак.ПутьКэшаCDN);
		КэшCDN = ЗагрузитьКэшCDN(ПараметрыЧестныйЗнак.ПутьКэшаCDN);
		ДоступныеCDN = КэшCDN;
	КонецЕсли;
	
	// Сортируем CDN по задержке
	СортироватьМассивСтруктур(ДоступныеCDN, "Задержка");
	
	// 3. Формируем тело запроса
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("codes", Новый Массив);
	ТелоЗапроса.codes.Добавить(КодМаркировки);
	
	// Добавляем номер фискального накопителя если есть
	Если ПараметрыЧестныйЗнак.Свойство("НомерФискальногоНакопителя") И СтрДлина(ПараметрыЧестныйЗнак.НомерФискальногоНакопителя) > 0 Тогда
		ТелоЗапроса.Вставить("fiscalDriveNumber", ПараметрыЧестныйЗнак.НомерФискальногоНакопителя);
	КонецЕсли;
	
	// 4. Обходим CDN площадки
	Заголовки = СформироватьЗаголовкиAPI(ПараметрыЧестныйЗнак.ТокенAPI);
	КоличествоПопыток = 0;
	ОнлайнПроверкаНеУдалась = Ложь;
	
	Для Каждого CDN Из ДоступныеCDN Цикл
		ХостCDN = CDN.Хост;
		URL = СокрЛП(ХостCDN) + "/api/v4/true-api/codes/check";
		
		Логировать("Пробуем CDN: " + ХостCDN);
		
		// Устанавливаем таймаут 2 секунды с запасом (требование: 1.5 сек)
		// В тонком клиенте используем ТекущаяДата() вместо ТекущаяДата()
		НачалоВремени =  ТекущаяДата();
		// Используем правильный подход для 1С с объектом ЗаписьJSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
		JSONТекст = ЗаписьJSON.Закрыть();
		РезультатAPI = ВыполнитьJSONЗапрос(URL, Заголовки, JSONТекст, 2);
		КонецВремени =  ТекущаяДата();
		
		// Вычисляем задержку в миллисекундах
		Задержка = КонецВремени - НачалоВремени;
		КоличествоПопыток = КоличествоПопыток + 1;
				
		// Проверяем таймаут 1.5 сек согласно ППРФ 1944 п. 17
		Если Не РезультатAPI.Успех и (Задержка > 2 Или (РезультатAPI.Свойство("Таймаут") И РезультатAPI.Таймаут)) Тогда
			Логировать("CDN таймаут более 1.5 сек: " + ХостCDN + ", задержка=" + Задержка + "с", "WARNING");
			//Если КоличествоПопыток >= ПараметрыЧестныйЗнак.МаксимальноеКоличествоПопыток Тогда
			ПометитьCDNНедоступным(ХостCDN, ПараметрыЧестныйЗнак.ПутьКэшаCDN);
			//КонецЕсли;
			ОнлайнПроверкаНеУдалась = Истина;
			Продолжить;
		КонецЕсли;
		
		// Проверяем успешность запроса
		Если Не РезультатAPI.Успех Тогда
			Логировать("Ошибка запроса к CDN " + ХостCDN + ": " + РезультатAPI.Сообщение, "WARNING");
			ПометитьCDNНедоступным(ХостCDN, ПараметрыЧестныйЗнак.ПутьКэшаCDN);
			ОнлайнПроверкаНеУдалась = Истина;
			Продолжить;
		КонецЕсли;				
		
		// Проверяем наличие данных
		Данные = РезультатAPI.Данные;
		Если Данные = Неопределено Тогда
			Результат.Сообщение = "Ошибка декодирования JSON";
			Результат.Данные = РезультатAPI.СыройОтвет;
			ОнлайнПроверкаНеУдалась = Истина;
			Продолжить;
		КонецЕсли;
		
		// Обработка ошибок по HTTP кодам
		КодHTTP = РезультатAPI.КодОшибки;
		
		// 4xx ошибки (кроме 401 и 429) - возвращаем ошибку
		Если КодHTTP >= 400 И КодHTTP < 500 И КодHTTP <> 401 И КодHTTP <> 429 Тогда
			ОписаниеОшибки = "";
			Если Данные.Свойство("description") Тогда
				ОписаниеОшибки = Данные.description;
			КонецЕсли;
			Результат.Сообщение = "Ошибка в запросе: " + ОписаниеОшибки;
			Результат.Данные = Данные;
			Результат.КодОшибки = КодHTTP;
			Возврат Результат;
		КонецЕсли;
		
		// 401 - ошибка авторизации
		Если КодHTTP = 401 Тогда
			ОписаниеОшибки = "";
			Если Данные.Свойство("description") Тогда
				ОписаниеОшибки = Данные.description;
			КонецЕсли;
			Результат.Сообщение = "Ошибка авторизации (401): " + ОписаниеОшибки;
			Результат.Данные = Данные;
			Результат.КодОшибки = КодHTTP;
			Возврат Результат;
		КонецЕсли;
		
		// 429 или 5xx - повторная попытка
		Если КодHTTP = 429 Или (КодHTTP >= 500 И КодHTTP < 600) Тогда
			Логировать("CDN " + ХостCDN + " ответил ошибкой " + КодHTTP + ", повторная попытка...", "WARNING");
			
			// Небольшая задержка перед повторной попыткой
			// В тонком клиенте убираем задержку, так как функция Задержка недоступна
			// Задержка(1);
			
			// Повторная попытка
			// Используем правильный подход для 1С с объектом ЗаписьJSON
			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
			JSONТекст = ЗаписьJSON.Закрыть();
			РезультатAPI2 = ВыполнитьJSONЗапрос(URL, Заголовки, JSONТекст, 2);
			Данные2 = РезультатAPI2.Данные;
			
			Если Не РезультатAPI2.Успех Или РезультатAPI2.КодОшибки = КодHTTP Тогда
				ПометитьCDNНедоступным(ХостCDN, ПараметрыЧестныйЗнак.ПутьКэшаCDN);
				Логировать("CDN " + ХостCDN + " помечен как недоступный на 15 минут", "WARNING");
				ОнлайнПроверкаНеУдалась = Истина;
				Продолжить;
			КонецЕсли;
			
			Данные = Данные2;
		КонецЕсли;
		
		// 5xx с code=5000 - повторяем 1 раз
		Если КодHTTP >= 500 И Данные.Свойство("code") И Данные.code = 5000 Тогда
			Логировать("CDN " + ХостCDN + " ответил 5000, повторная попытка...", "WARNING");
			
			// Используем правильный подход для 1С с объектом ЗаписьJSON
			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
			JSONТекст = ЗаписьJSON.Закрыть();
			РезультатAPI2 = ВыполнитьJSONЗапрос(URL, Заголовки, JSONТекст, 2);
			Данные2 = РезультатAPI2.Данные;
			
			Если Не РезультатAPI2.Успех Или (РезультатAPI2.КодОшибки >= 500 И Данные2.Свойство("code") И Данные2.code = 5000) Тогда
				ОписаниеОшибки = "";
				Если Данные2.Свойство("description") Тогда
					ОписаниеОшибки = Данные2.description;
				КонецЕсли;
				Результат.Сообщение = "Ошибка 5000: " + ОписаниеОшибки;
				Результат.Данные = Данные2;
				Результат.КодОшибки = РезультатAPI2.КодОшибки;
				ОнлайнПроверкаНеУдалась = Истина;
				Продолжить;
			КонецЕсли;
			
			Данные = Данные2;
		КонецЕсли;
		
		// Успешный ответ
		Логировать("CDN " + ХостCDN + " ответил успешно, задержка: " + Задержка + "c");
		
		// Формируем успешный результат
		Результат.Успех = Истина;
		Результат.Данные = Данные;
		Результат.Сообщение = "Маркировка проверена онлайн через CDN " + ХостCDN;
		Результат.Таймаут = Ложь;
		Результат.ПровереноОфлайн = Ложь;
		
		Возврат Результат;
	КонецЦикла;
	
	// Если все CDN недоступны или произошли ошибки
	Если ОнлайнПроверкаНеУдалась Тогда
		Результат.Сообщение = "Не удалось проверить маркировку: все CDN недоступны или ошибка запроса";
		Логировать(Результат.Сообщение, "WARNING");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Выполняет офлайн проверку маркировки через локальный модуль ЧЗ
//
// Параметры:
//  КодМаркировки - Строка - код маркировки для проверки
//  ПараметрыЧестныйЗнак     - Структура - параметры проверки
//
// Возвращаемое значение:
//  Структура - результат офлайн проверки
//
&НаКлиенте
Функция ПроверитьОфлайн(КодМаркировки, ПараметрыЧестныйЗнак = Неопределено) Экспорт
	Результат = СоздатьСтруктуруРезультата();
	ПараметрыЧестныйЗнак = ОбъединитьПараметры(ПараметрыЧестныйЗнак);
	
	Логировать("Начинаем офлайн проверку маркировки: " + КодМаркировки);
	
	// 1. Проверяем готовность локального модуля ЧЗ
	РезультатГотовности = ПроверитьГотовностьЛМЧЗ(ПараметрыЧестныйЗнак);
	Если Не РезультатГотовности.Успех Тогда
		Результат.Сообщение = "Локальный модуль ЧЗ не готов: " + РезультатГотовности.Сообщение;
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	Логировать("Локальный модуль ЧЗ готов к работе");
	
	// 2. Извлекаем CIS из маркировки
	CIS = КодМаркировки;
	Логировать("Извлечен CIS: " + CIS);
	
	// 3. Проверяем CIS в локальном модуле ЧЗ
	РезультатПроверки = ПроверитьCISВЛМЧЗ(CIS, ПараметрыЧестныйЗнак);
	Если Не РезультатПроверки.Успех Тогда
		Результат.Сообщение = "Ошибка проверки CIS в ЛМ ЧЗ: " + РезультатПроверки.Сообщение;
		Логировать(Результат.Сообщение, "ERROR");
		Возврат Результат;
	КонецЕсли;
	
	// 4. Формируем успешный результат
	Результат.Успех = Истина;
	Результат.Данные = РезультатПроверки.Данные;
	Результат.Сообщение = "Маркировка проверена офлайн через локальный модуль ЧЗ";
	Результат.Таймаут = Ложь;
	Результат.ПровереноОфлайн = Истина;
	
	Логировать("Офлайн проверка завершена успешно");
	
	Возврат Результат;
КонецФункции

#КонецОбласти

