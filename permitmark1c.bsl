	Результат.Вставить("НазваниеТеста", "Полное тестирование модуля");
	Результат.Вставить("Описание", "Выполнение всех тестов модуля");
	
	Попытка
		// Выполняем все тесты
		Тесты = Новый Массив;
		Тесты.Добавить(ТестБазовойСтруктуры());
		Тесты.Добавить(ТестHTTPКлиента());
		Тесты.Добавить(ТестУправленияCDN());
		Тесты.Добавить(ТестЛокальногоМодуляЧЗ());
		Тесты.Добавить(ТестОсновнойЛогики());
		
		// Подсчитываем результаты
		УспешныхТестов = 0;
		НеуспешныхТестов = 0;
		
		Для Каждого Тест Из Тесты Цикл
			Если Тест.Успех Тогда
				УспешныхТестов = УспешныхТестов + 1;
			Иначе
				НеуспешныхТестов = НеуспешныхТестов + 1;
			КонецЕсли;
		КонецЦикла;
		
		// Формируем результат
		Если НеуспешныхТестов = 0 Тогда
			Результат.Успех = Истина;
			Результат.Сообщение = "Все тесты прошли успешно";
		Иначе
			Результат.Сообщение = "Не все тесты прошли успешно";
		КонецЕсли;
		
		Результат.Данные = "Успешно: " + УспешныхТестов + ", Неуспешно: " + НеуспешныхТестов;
		
	Исключение
		Результат.Сообщение = "Ошибка полного тестирования: " + ОписаниеОшибки();
		Результат.Данные = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

