procedure TfmMain.GetDeviceMetrics;
const
  NettoWeight     : array [Boolean] of string = ('Вес Брутто','Вес Нетто');
begin
  Memo.Lines.Clear;
  Memo.Lines.Add('Версия протокола: '+IntToStr(ScaleX.UProtocolVersion));
  Memo.Lines.Add('Тип устройства: '+IntToStr(ScaleX.UType));
  Memo.Lines.Add('Модель устройства: '+IntToStr(ScaleX.UModel));
  Memo.Lines.Add(Format('Версия программы: %d.%d.%.4d',
  [ScaleX.UMajorVersion, ScaleX.UMinorVersion, ScaleX.UBuild]));
  Memo.Lines.Add(Format('Кодовая страница: %d', [ScaleX.UCodePage]));
  Memo.Lines.Add('Название устройства: '+Chr(13));
  Memo.Lines.Add(Format('"%s"', [ScaleX.UDescription]));
  Memo.Lines.Add('Режим работы: '+IntToStr(ScaleX.UMode));
end;

