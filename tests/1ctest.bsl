// ==========================================
// АСИНХРОННАЯ ПРОВЕРКА МАРКИ
// ==========================================

// Функция запуска проверки марки (возвращает ID задачи)
// Параметры:
//   КодМарки - Строка - код маркировки для проверки
// Возвращаемое значение:
//   Структура - {success: Булево, taskId: Строка, message: Строка}
//
Функция НачатьПроверкуМарки(КодМарки) Экспорт
    
    // Подготовка данных для отправки
    Данные = Новый Структура;
    Данные.Вставить("markingCode", КодМарки);
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ДанныеJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос (асинхронный endpoint)
    Результат = ОтправитьPOSTЗапрос("/api/check-marking-code-async", ДанныеJSON);
    
    Если Результат = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    // Возвращаем результат с ID задачи
    Возврат Результат;
    
КонецФункции

// Функция получения результата проверки марки по ID
// Параметры:
//   ИдентификаторЗадачи - Строка - ID задачи, полученный от НачатьПроверкуМарки
// Возвращаемое значение:
//   Структура - {success: Булево, status: Строка, result: Структура}
//     status может быть: "pending" (выполняется), "completed" (завершено), "error" (ошибка)
//
Функция ПолучитьРезультатПроверкиМарки(ИдентификаторЗадачи) Экспорт
    
    // Отправляем GET запрос для получения статуса
    АдресURL = "/api/check-marking-result/" + ИдентификаторЗадачи;
    Результат = ОтправитьGETЗапрос(АдресURL);
    
    Если Результат = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// ==========================================
// СИНХРОННАЯ ПРОВЕРКА МАРКИ (старый метод)
// ==========================================

// Функция синхронной проверки марки (ждет завершения)
// Параметры:
//   КодМарки - Строка - код маркировки для проверки
// Возвращаемое значение:
//   Структура - результат проверки
//
Функция ПроверитьМарку(КодМарки) Экспорт
    
    // Подготовка данных для отправки
    Данные = Новый Структура;
    Данные.Вставить("markingCode", КодМарки);
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ДанныеJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос
    Результат = ОтправитьPOSTЗапрос("/api/check-marking-code", ДанныеJSON);
    
    Если Результат = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// ==========================================
// ПРОВЕРКА РАЗРЕШЕНИЯ МАРКИРОВКИ
// ==========================================

// Функция проверки разрешения маркировки
// Параметры:
//   КодМарки - Строка - код маркировки для проверки разрешения
// Возвращаемое значение:
//   Структура - результат проверки разрешения
//
Функция ПроверитьРазрешениеМаркировки(КодМарки) Экспорт
    
    // Подготовка данных для отправки
    Данные = Новый Структура;
    Данные.Вставить("permitMark", КодМарки);
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ДанныеJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос
    Результат = ОтправитьPOSTЗапрос("/api/check-permit-mark", ДанныеJSON);
    
    Если Результат = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// ==========================================
// ПРИМЕРЫ ИСПОЛЬЗОВАНИЯ
// ==========================================

// Пример 1: Асинхронная проверка марки
Процедура ПримерАсинхроннойПроверки()
    
    КодМарки = "0104607008480429215KpOL.jHnx6Xm93kl/E";
    
    // Шаг 1: Запускаем проверку и получаем ID
    Сообщить("Запускаем проверку марки...");
    РезультатЗапуска = НачатьПроверкуМарки(КодМарки);
    
    Если РезультатЗапуска.success Тогда
        ИдентификаторЗадачи = РезультатЗапуска.taskId;
        Сообщить("Проверка запущена. ID задачи: " + ИдентификаторЗадачи);
        
        // Шаг 2: Опрашиваем статус (можно делать это в цикле с задержкой)
        МаксимумПопыток = 60; // Максимум 60 попыток
        Попытка = 0;
        
        Пока Попытка < МаксимумПопыток Цикл
            
            РезультатПроверки = ПолучитьРезультатПроверкиМарки(ИдентификаторЗадачи);
            
            Если РезультатПроверки.success Тогда
                
                Если РезультатПроверки.status = "completed" Тогда
                    Сообщить("Проверка завершена!");
                    Сообщить("Результат: " + Строка(РезультатПроверки.result));
                    Прервать;
                    
                ИначеЕсли РезультатПроверки.status = "error" Тогда
                    Сообщить("Ошибка проверки: " + РезультатПроверки.message);
                    Прервать;
                    
                Иначе // pending
                    Сообщить("Проверка в процессе... (попытка " + Формат(Попытка + 1, "ЧГ=") + ")");
                    Ждать(1); // Ждем 1 секунду перед следующей проверкой
                    
                КонецЕсли;
                
            Иначе
                Сообщить("Ошибка получения статуса: " + РезультатПроверки.message);
                Прервать;
            КонецЕсли;
            
            Попытка = Попытка + 1;
            
        КонецЦикла;
        
        Если Попытка >= МаксимумПопыток Тогда
            Сообщить("Превышено время ожидания результата проверки");
        КонецЕсли;
        
    Иначе
        Сообщить("Ошибка запуска проверки: " + РезультатЗапуска.message);
    КонецЕсли;
    
КонецПроцедуры

// Пример 2: Синхронная проверка марки (старый способ)
Процедура ПримерСинхроннойПроверки()
    
    КодМарки = "0104607008480429215KpOL.jHnx6Xm93kl/E";
    
    Сообщить("Проверяем марку (синхронно)...");
    Результат = ПроверитьМарку(КодМарки);
    
    Если Результат.success Тогда
        Сообщить("Марка проверена успешно!");
        Сообщить("Результат: " + Строка(Результат.data));
    Иначе
        Сообщить("Ошибка проверки марки: " + Результат.message);
    КонецЕсли;
    
КонецПроцедуры

// Пример 3: Проверка разрешения маркировки
Процедура ПримерПроверкиРазрешения()
    
    КодМарки = "0104607008480429215KpOL.jHnx6Xm93kl/E";
    
    Сообщить("Проверяем разрешение маркировки...");
    Результат = ПроверитьРазрешениеМаркировки(КодМарки);
    
    Если Результат.success Тогда
        Сообщить("Разрешение проверено успешно!");
        Сообщить("Результат: " + Строка(Результат.data));
    Иначе
        Сообщить("Ошибка проверки разрешения: " + Результат.message);
    КонецЕсли;
    
КонецПроцедуры

