// ==========================================
// АСИНХРОННАЯ ПРОВЕРКА МАРКИ
// ==========================================

// Функция запуска проверки марки (возвращает ID задачи)
// Параметры:
//   КодМарки - Строка - код маркировки для проверки
//   ТипОперации - Строка - тип операции (sell/return), по умолчанию 'sell'
//   СтатусТовара - Строка - статус товара (необязательно)
// Возвращаемое значение:
//   Структура - {success: Булево, taskId: Строка, message: Строка}
//
Функция НачатьПроверкуМарки(КодМарки, ТипОперации = "sell", СтатусТовара = "") Экспорт
    
    // Подготовка данных для отправки
    Данные = Новый Структура;
    Данные.Вставить("markingCode", КодМарки);
    Данные.Вставить("sellOrReturn", ТипОперации);
    
    Если Не ПустаяСтрока(СтатусТовара) Тогда
        Данные.Вставить("itemEstimatedStatus", СтатусТовара);
    КонецЕсли;
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ДанныеJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос (асинхронный endpoint)
    Ответ = ОтправитьPOSTЗапрос("/api/check-marking-code-async", ДанныеJSON);
    
    Если Ответ = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    // Проверяем формат ответа
    Если Не Ответ.Свойство("success") Тогда
        Возврат Новый Структура("success, message", Ложь, "Неверный формат ответа от сервера");
    КонецЕсли;
    
    Если Не Ответ.success Тогда
        ТекстОшибки = "";
        Если Ответ.Свойство("message") Тогда
            ТекстОшибки = Ответ.message;
        КонецЕсли;
        Возврат Новый Структура("success, message", Ложь, ТекстОшибки);
    КонецЕсли;
    
    // Извлекаем taskId из data
    Если Ответ.Свойство("data") И ТипЗнч(Ответ.data) = Тип("Структура") Тогда
        Если Ответ.data.Свойство("taskId") Тогда
            Возврат Новый Структура("success, taskId, message", Истина, Ответ.data.taskId, "Задача создана");
        КонецЕсли;
    КонецЕсли;
    
    // Если не нашли taskId
    Возврат Новый Структура("success, message", Ложь, "ID задачи не найден в ответе сервера");
    
КонецФункции

// Функция получения результата проверки марки по ID
// Параметры:
//   ИдентификаторЗадачи - Строка - ID задачи, полученный от НачатьПроверкуМарки
// Возвращаемое значение:
//   Структура - {success: Булево, status: Строка, result: Структура, error: Строка}
//     status может быть: "pending" (ожидает), "processing" (выполняется), "completed" (завершено), "error" (ошибка)
//
Функция ПолучитьРезультатПроверкиМарки(ИдентификаторЗадачи) Экспорт
    
    // Отправляем GET запрос для получения статуса
    АдресURL = "/api/check-marking-result/" + ИдентификаторЗадачи;
    Ответ = ОтправитьGETЗапрос(АдресURL);
    
    Если Ответ = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    // Проверяем формат ответа
    Если Не Ответ.Свойство("success") Тогда
        Возврат Новый Структура("success, message", Ложь, "Неверный формат ответа от сервера");
    КонецЕсли;
    
    Если Не Ответ.success Тогда
        ТекстОшибки = "";
        Если Ответ.Свойство("message") Тогда
            ТекстОшибки = Ответ.message;
        КонецЕсли;
        Возврат Новый Структура("success, message", Ложь, ТекстОшибки);
    КонецЕсли;
    
    // Извлекаем данные из ответа
    Если Ответ.Свойство("data") И ТипЗнч(Ответ.data) = Тип("Структура") Тогда
        
        РезультатСтруктура = Новый Структура;
        РезультатСтруктура.Вставить("success", Истина);
        
        // Статус задачи
        Если Ответ.data.Свойство("status") Тогда
            РезультатСтруктура.Вставить("status", Ответ.data.status);
        Иначе
            РезультатСтруктура.Вставить("status", "unknown");
        КонецЕсли;
        
        // Результат (если задача завершена)
        Если Ответ.data.Свойство("result") Тогда
            РезультатСтруктура.Вставить("result", Ответ.data.result);
        Иначе
            РезультатСтруктура.Вставить("result", Неопределено);
        КонецЕсли;
        
        // Ошибка (если задача завершилась с ошибкой)
        Если Ответ.data.Свойство("error") Тогда
            РезультатСтруктура.Вставить("error", Ответ.data.error);
        Иначе
            РезультатСтруктура.Вставить("error", "");
        КонецЕсли;
        
        // Сообщение
        Если Ответ.Свойство("message") Тогда
            РезультатСтруктура.Вставить("message", Ответ.message);
        Иначе
            РезультатСтруктура.Вставить("message", "");
        КонецЕсли;
        
        Возврат РезультатСтруктура;
        
    КонецЕсли;
    
    // Если данные не найдены
    Возврат Новый Структура("success, message", Ложь, "Данные задачи не найдены в ответе сервера");
    
КонецФункции

// ==========================================
// СИНХРОННАЯ ПРОВЕРКА МАРКИ (старый метод)
// ==========================================

// Функция синхронной проверки марки (ждет завершения)
// Параметры:
//   КодМарки - Строка - код маркировки для проверки
// Возвращаемое значение:
//   Структура - результат проверки
//
Функция ПроверитьМарку(КодМарки) Экспорт
    
    // Подготовка данных для отправки
    Данные = Новый Структура;
    Данные.Вставить("markingCode", КодМарки);
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ДанныеJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос
    Результат = ОтправитьPOSTЗапрос("/api/check-marking-code", ДанныеJSON);
    
    Если Результат = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// ==========================================
// ПРОВЕРКА РАЗРЕШЕНИЯ МАРКИРОВКИ
// ==========================================

// Функция проверки разрешения маркировки
// Параметры:
//   КодМарки - Строка - код маркировки для проверки разрешения
// Возвращаемое значение:
//   Структура - результат проверки разрешения
//
Функция ПроверитьРазрешениеМаркировки(КодМарки) Экспорт
    
    // Подготовка данных для отправки
    Данные = Новый Структура;
    Данные.Вставить("permitMark", КодМарки);
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ДанныеJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос
    Результат = ОтправитьPOSTЗапрос("/api/check-permit-mark", ДанныеJSON);
    
    Если Результат = Неопределено Тогда
        Возврат Новый Структура("success, message", Ложь, "Ошибка соединения с сервисом");
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// ==========================================
// ПРИМЕРЫ ИСПОЛЬЗОВАНИЯ
// ==========================================

// Пример 1: Асинхронная проверка марки
Процедура ПримерАсинхроннойПроверки()
    
    КодМарки = "0104607008480429215KpOL.jHnx6Xm93kl/E";
    
    // Шаг 1: Запускаем проверку и получаем ID
    Сообщить("Запускаем проверку марки...");
    РезультатЗапуска = НачатьПроверкуМарки(КодМарки, "sell"); // "sell" или "return"
    
    Если РезультатЗапуска.success Тогда
        ИдентификаторЗадачи = РезультатЗапуска.taskId;
        Сообщить("Проверка запущена. ID задачи: " + ИдентификаторЗадачи);
        
        // Шаг 2: Опрашиваем статус (можно делать это в цикле с задержкой)
        МаксимумПопыток = 60; // Максимум 60 попыток (60 секунд)
        Попытка = 0;
        
        Пока Попытка < МаксимумПопыток Цикл
            
            РезультатПроверки = ПолучитьРезультатПроверкиМарки(ИдентификаторЗадачи);
            
            Если РезультатПроверки.success Тогда
                
                Если РезультатПроверки.status = "completed" Тогда
                    Сообщить("✓ Проверка завершена успешно!");
                    
                    // Выводим результат
                    Если РезультатПроверки.result <> Неопределено Тогда
                        Результат = РезультатПроверки.result;
                        
                        // Проверяем успешность проверки на ККТ
                        Если Результат.Свойство("success") И Результат.success Тогда
                            Сообщить("Марка проверена на ККТ успешно!");
                            
                            // Выводим информацию о марке
                            Если Результат.Свойство("response") Тогда
                                Ответ = Результат.response;
                                Если ТипЗнч(Ответ) = Тип("Структура") Тогда
                                    Сообщить("Детали проверки марки:");
                                    Для Каждого Элемент Из Ответ Цикл
                                        Сообщить("  " + Элемент.Ключ + ": " + Строка(Элемент.Значение));
                                    КонецЦикла;
                                КонецЕсли;
                            КонецЕсли;
                        Иначе
                            Сообщить("⚠ Марка не прошла проверку на ККТ");
                            Если Результат.Свойство("error") Тогда
                                Сообщить("Ошибка: " + Результат.error);
                            КонецЕсли;
                        КонецЕсли;
                    КонецЕсли;
                    
                    Прервать;
                    
                ИначеЕсли РезультатПроверки.status = "error" Тогда
                    Сообщить("✗ Ошибка проверки: " + РезультатПроверки.error);
                    Прервать;
                    
                Иначе // pending или processing
                    Сообщить("⏳ Проверка в процессе... (попытка " + Формат(Попытка + 1, "ЧГ=") + " из " + Формат(МаксимумПопыток, "ЧГ=") + ")");
                    Ждать(1); // Ждем 1 секунду перед следующей проверкой
                    
                КонецЕсли;
                
            Иначе
                Сообщить("✗ Ошибка получения статуса: " + РезультатПроверки.message);
                Прервать;
            КонецЕсли;
            
            Попытка = Попытка + 1;
            
        КонецЦикла;
        
        Если Попытка >= МаксимумПопыток Тогда
            Сообщить("⏱ Превышено время ожидания результата проверки (" + Формат(МаксимумПопыток, "ЧГ=") + " секунд)");
        КонецЕсли;
        
    Иначе
        Сообщить("✗ Ошибка запуска проверки: " + РезультатЗапуска.message);
    КонецЕсли;
    
КонецПроцедуры

// Пример 1a: Асинхронная проверка марки БЕЗ ожидания результата
// (запустили и забыли, проверим результат позже)
Процедура ПримерАсинхроннойПроверкиБезОжидания()
    
    КодМарки = "0104607008480429215KpOL.jHnx6Xm93kl/E";
    
    // Запускаем проверку
    Сообщить("Запускаем проверку марки...");
    РезультатЗапуска = НачатьПроверкуМарки(КодМарки, "sell");
    
    Если РезультатЗапуска.success Тогда
        ИдентификаторЗадачи = РезультатЗапуска.taskId;
        Сообщить("✓ Проверка запущена. ID задачи: " + ИдентификаторЗадачи);
        Сообщить("Результат можно получить позже, вызвав:");
        Сообщить("ПолучитьРезультатПроверкиМарки(""" + ИдентификаторЗадачи + """)");
        
        // Здесь мы НЕ ждем завершения, а просто возвращаемся
        // В реальном приложении ID можно сохранить в базе данных
        // и проверить результат позже
        
    Иначе
        Сообщить("✗ Ошибка запуска проверки: " + РезультатЗапуска.message);
    КонецЕсли;
    
КонецПроцедуры

// Пример 2: Синхронная проверка марки (старый способ)
Процедура ПримерСинхроннойПроверки()
    
    КодМарки = "0104607008480429215KpOL.jHnx6Xm93kl/E";
    
    Сообщить("Проверяем марку (синхронно)...");
    Результат = ПроверитьМарку(КодМарки);
    
    Если Результат.success Тогда
        Сообщить("Марка проверена успешно!");
        Сообщить("Результат: " + Строка(Результат.data));
    Иначе
        Сообщить("Ошибка проверки марки: " + Результат.message);
    КонецЕсли;
    
КонецПроцедуры

// Пример 3: Проверка разрешения маркировки
Процедура ПримерПроверкиРазрешения()
    
    КодМарки = "0104607008480429215KpOL.jHnx6Xm93kl/E";
    
    Сообщить("Проверяем разрешение маркировки...");
    Результат = ПроверитьРазрешениеМаркировки(КодМарки);
    
    Если Результат.success Тогда
        Сообщить("Разрешение проверено успешно!");
        Сообщить("Результат: " + Строка(Результат.data));
    Иначе
        Сообщить("Ошибка проверки разрешения: " + Результат.message);
    КонецЕсли;
    
КонецПроцедуры

