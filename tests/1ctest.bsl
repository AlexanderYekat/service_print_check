// Модуль для тестирования сервиса печати чеков из 1С
// Проверка марки с асинхронным механизмом через ID

// Базовый URL сервиса
Перем АдресСервиса;

// Инициализация
Процедура ПриСозданииНаСервере()
    АдресСервиса = "http://localhost:8000";
КонецПроцедуры

// Функция отправки HTTP POST запроса
Функция ОтправитьPOSTЗапрос(АдресURL, ДанныеJSON)
    
    Попытка
        // Создаем HTTP соединение
        Соединение = Новый HTTPСоединение(
            "localhost",
            8000,
            ,
            ,
            ,
            30  // Таймаут 30 секунд
        );
        
        // Создаем HTTP запрос
        Запрос = Новый HTTPЗапрос(АдресURL);
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(ДанныеJSON, КодировкаТекста.UTF8);
        
        // Отправляем запрос
        Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
        
        // Получаем тело ответа
        ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
        
        // Парсим JSON
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        Возврат Результат;
        
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        Сообщить("Ошибка при отправке запроса: " + ТекстОшибки);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Функция отправки HTTP GET запроса
