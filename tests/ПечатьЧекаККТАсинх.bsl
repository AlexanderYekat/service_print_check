// Модуль для асинхронной проверки маркировки из 1С
// Использует API: /api/check-marking-code-async

//// Переменные для хранения состояния проверки
//Перем ТекущийИдентификаторЗадачи;
//Перем ТекущаяПопытка;
//Перем МаксимальноеКоличествоПопыток;
//Перем ОбработчикЗавершения;

// ==========================================
// ОСНОВНАЯ ФУНКЦИЯ
// ==========================================

// Асинхронная проверка марки на ККТ
// Параметры:
//   КодМарки - Строка - код маркировки для проверки
//   ТипОперации - Строка - тип операции: "sell", "return", "buyReturn" (по умолчанию "sell")
//   МаксимумПопыток - Число - максимум попыток получения результата (по умолчанию 30 = 60 секунд)
//   ОбработчикРезультата - Строка - имя процедуры для обработки результата (необязательно)
// Возвращаемое значение:
//   Булево - Истина если запрос отправлен успешно
//
Функция ПроверитьМаркуНаККТ(КодМарки, ТипОперации = "sell", МаксимумПопыток = 30, ОбработчикРезультата = "", ЭмуляцияОтвета = ЛОЖЬ) Экспорт    
    // Подготовка данных   
	ТекущийИдентификаторЗадачи = "";
    Данные = Новый Структура;
    Данные.Вставить("markingCode", КодМарки);
    Данные.Вставить("sellOrReturn", ТипОперации);
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    ДанныеJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос на запуск проверки
	Попытка                                                     
        Соединение = Новый HTTPСоединение("localhost", 8000, , , , 1);
        Запрос = Новый HTTPЗапрос("/api/check-marking-code-async");
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(ДанныеJSON, КодировкаТекста.UTF8);
		
		Если ЭмуляцияОтвета тогда
			ТелоОтвета = "{""success"": true, ""data"": {""taskId"": ""эмуляция-ответа-1""}}";
		иначе
        	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
        	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		конецЕсли;
        
        // Парсим JSON
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
        РезультатОтвета = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
    Исключение
        Сообщить("Ошибка соединения с сервисом: " + ОписаниеОшибки());
        Возврат ТекущийИдентификаторЗадачи;
    КонецПопытки;
    
    // Проверяем ответ
    Если Не РезультатОтвета.Свойство("success") ИЛИ Не РезультатОтвета.success Тогда
        ТекстОшибки = "Ошибка запуска проверки";
        Если РезультатОтвета.Свойство("message") Тогда
            ТекстОшибки = РезультатОтвета.message;
        КонецЕсли;
        Сообщить(ТекстОшибки);
        Возврат ТекущийИдентификаторЗадачи;
    КонецЕсли;
    
    // Извлекаем taskId
    Если Не РезультатОтвета.Свойство("data") ИЛИ Не РезультатОтвета.data.Свойство("taskId") Тогда
        Сообщить("ID задачи не найден в ответе сервера");
        Возврат ТекущийИдентификаторЗадачи;
    КонецЕсли;
    
    // Сохраняем параметры для обработчика ожидания
    ТекущийИдентификаторЗадачи = РезультатОтвета.data.taskId;
    ТекущаяПопытка = 0;
    МаксимальноеКоличествоПопыток = МаксимумПопыток;
    ОбработчикЗавершения = ОбработчикРезультата;
    
    // Подключаем обработчик ожидания (вызов каждые 2 секунды)
    //ПодключитьОбработчикОжидания("ПроверитьСтатусЗадачиМаркировки", 2);
    
    Сообщить("Проверка марки запущена. ID: " + ТекущийИдентификаторЗадачи);    
    Возврат ТекущийИдентификаторЗадачи;    
КонецФункции